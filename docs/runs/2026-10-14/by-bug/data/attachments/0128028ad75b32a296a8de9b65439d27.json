{
  "ios": {
    "file": "apps/web/ios/App/App/Info.plist",
    "NSAllowsArbitraryLoads": false,
    "NSExceptionDomains": false,
    "NSAllowsLocalNetworking": {
      "line": 31
    },
    "NSFaceIDUsageDescription": false
  },
  "android": {
    "mainManifest": "apps/web/android/app/src/main/AndroidManifest.xml",
    "usesCleartextTraffic": "false",
    "usesCleartextTrafficLine": 12,
    "mainNetworkSecurityConfig": false,
    "debugManifestSetsNsc": true,
    "debugNsc": {
      "file": "apps/web/android/app/src/debug/res/xml/debug_network_security_config.xml",
      "cleartextDomains": [
        "localhost",
        "127.0.0.1",
        "172.20.10.6"
      ]
    },
    "note": "src/debug/ is merged only into debug builds; a release APK's merged manifest is not in the repo (needs the CI artefact)."
  },
  "capacitor": {
    "file": "apps/web/capacitor.config.ts",
    "serverUrl": "not set",
    "cleartext": false,
    "androidScheme": "https"
  },
  "plugins": {
    "capacitor": [
      "@capacitor/android",
      "@capacitor/app",
      "@capacitor/clipboard",
      "@capacitor/core",
      "@capacitor/ios",
      "@capacitor/keyboard",
      "@capacitor/status-bar",
      "@capgo/capacitor-speech-recognition",
      "@capacitor/cli"
    ],
    "biometric": [],
    "secureStorage": []
  },
  "firebaseConfigFiles": [],
  "nativeSecretPatternHits": [],
  "nativeFilesScanned": 40

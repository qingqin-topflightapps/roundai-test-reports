ssed":false,"contentLength":214511},"type":"attachment"},{"link":{"id":"0a87889dfde72c444d0ba1d6e2d063fd","originalFileName":"2b4d8ab3-5121-41e8-8848-420b5d543870-attachment.png","ext":".png","name":"newspec-c/evidence/dvc-tc25-s22-snf-02c-computer-after-phone-add.png","contentType":"image/png","used":true,"missed":false,"contentLength":87894},"type":"attachment"},{"link":{"id":"4c37e2e57e78b4ec586dff8bfd34640a","originalFileName":"61f02110-bc16-4858-9ce6-973b8b1d3e40-attachment.png","ext":".png","name":"newspec-c/evidence/dvc-tc25-s22-snf-03a-phone-chart-before.device.png","contentType":"image/png","used":true,"missed":false,"contentLength":42981},"type":"attachment"},{"link":{"id":"7157a3fec733ba6b6dfe44de54662103","originalFileName":"8ac43fff-e06a-4a64-b0e7-c59445105b99-attachment.png","ext":".png","name":"newspec-c/evidence/dvc-tc25-s22-snf-03b-phone-chart-after-computer-save.device.png","contentType":"image/png","used":true,"missed":false,"contentLength":215300},"type":"attachment"},{"link":{"id":"3834f013ba5576c9f4f593509ec6f684","originalFileName":"f32ef464-eea3-41fd-a738-d72c05f443bb-attachment.png","ext":".png","name":"newspec-c/evidence/dvc-tc25-s22-snf-03c-computer-after-save.png","contentType":"image/png","used":true,"missed":false,"contentLength":121031},"type":"attachment"},{"link":{"id":"b8bfd6fc97e9c61827220416deecac5c","originalFileName":"b233f740-8dda-4f60-8f35-8a2e17441003-attachment.png","ext":".png","name":"newspec-c/evidence/dvc-tc25-s22-snf-04a-phone-encounter.device.png","contentType":"image/png","used":true,"missed":false,"contentLength":181089},"type":"attachment"},{"link":{"id":"b6ed265d55831a0131ee21da05dc6ad9","originalFileName":"ff65e741-c749-43b2-9939-9a2dccdeb411-attachment.png","ext":".png","name":"newspec-c/evidence/dvc-tc25-s22-snf-04b-phone-after-generate.device.png","contentType":"image/png","used":true,"missed":false,"contentLength":187346},"type":"attachment"},{"link":{"id":"875e5c7db763ecdaedffcd44a87bd1c6","originalFileName":"909aa784-8e4a-4fe9-a9ef-e149a23e4ec6-attachment.png","ext":".png","name":"newspec-c/evidence/dvc-tc25-s22-snf-04c-computer-post-round.png","contentType":"image/png","used":true,"missed":false,"contentLength":73051},"type":"attachment"},{"link":{"id":"57ef9836709761662550e008ae45310e","originalFileName":"eccce659-a8be-4e85-8bc7-d5b40ad79cae-attachment.png","ext":".png","name":"newspec-c/evidence/dvc-tc25-s22-snf-05a-phone-list-before-delete.device.png","contentType":"image/png","used":true,"missed":false,"contentLength":227455},"type":"attachment"},{"link":{"id":"bc5c34d6220399654be5631ddfec4614","originalFileName":"28a1daaf-fcce-475f-aee4-7ea2864ec55b-attachment.png","ext":".png","name":"newspec-c/evidence/dvc-tc25-s22-snf-05b-phone-list-after-delete.device.png","contentType":"image/png","used":true,"missed":false,"contentLength":226054},"type":"attachment"},{"link":{"id":"89d7109113ab6dcace8bd4b4202bfec7","originalFileName":"2e1a3822-aaf9-4997-afc8-5576a19d9e02-attachment.json","ext":".json","name":"newspec-c/evidence/dvc-tc25-s22-snf.json","contentType":"application/json","used":true,"missed":false,"contentLength":4646},"type":"attachment"},{"link":{"used":true,"missed":false,"id":"423b09c72d2bf29f6bffeaf300e962cf","originalFileName":"0dfb892a-3a4f-445f-b0d0-366f858b1f16-attachment.json","ext":".json","contentType":"application/json","contentLength":6103,"name":"lane result (newspec-c/results.json)"},"type":"attachment"}],"error":{"message":"newspec-c: passed → passed (passed)\nAndroid rig: debug build of main e02167f bundled for the LOCAL stack only (bundle names 127.0.0.1:4510/4511, reached through adb reverse), built outside the checkout, on the rc_api36 emulator (Pixel 7, Android 16); Playwright attached to the app's own WebView; every ai/* action the app sends is answered or failed at the WebView's socket (no model call; aiCallLog had no new row in any run). Phone = the app, signed in through its own email-code form (POST 200, its own session); computer = desktop Chromium with a separate session, Hospital (S01 loop) and Nursing Home (S02 loop). T3 (TFA-92570, judged): own-form sign-in, an add made in the app is stored and listed like a web add, the computer's pre-round save reaches the app's chart the same way it reaches a second web session, Generate in the app (scripted note) stores and shows the note, and a delete on the computer removes the patient for the app: Hospital 8/8, Nursing Home 6/6 judged checks (no resident delete control exists on web or app: known B24 / Q3). Recorded only (U1-U6, gated TFA-94513 in progress / TFA-94704 backlog): the computer stayed signed in after the phone's sign-in; the phone's add showed on the computer without a refresh (3 ms / 309 ms); the phone's note showed on the computer's Post-Round without a refresh; the delete reached the phone in 322 ms; Nursing Home pre-round text and BP showed live on the phone. Hospital: the computer's saved pre-round TEXT did not appear on the app's open chart (nor on a second…"},"testCase":{"id":"145f3434094513f2e0cd0948424c90e3","externalId":"34a8cb925152b3e652a2ad4d807bb1dd","name":"[local] S22 Android app (debug build on the local stack) and desktop Chrome: steps 2-5 in both modes","fullName":"TC-25 Web & Phone Sync › TC-25/S22"},"descriptionHtml":"<div class=\"rc-approach\"><p><b>Approach</b> · TC-25 Web &amp; Phone Sync · <b>S22</b> Android app (debug build on the local stack) and desktop Chrome: steps 2-5 in both modes</p><p><b>UAT steps / ticket ACs covered:</b></p><ul><li><b>U1</b> The same account is signed in on a phone (app) and a computer (web) at the same time. Signing in on one does not sign out the other, and both stay signed in. (UAT TC-25 step 1; UAT TC-25; TFA-94513 AC 9; TFA-94704 AC 5) — gate: blocked: TFA-94513 in progress; TFA-94704 development backlog</li><li><b>U2</b> A patient added on the phone appears on the computer in real time, with no refresh or re-entry. (UAT TC-25 step 2; UAT TC-25; TFA-94704 AC 5; TFA-94513 AC 11) — gate: blocked: TFA-94513 in progress; TFA-94704 development backlog</li><li><b>U3</b> A pre-round note dictated and saved on the computer appears on the phone in real time, with no refresh, and can be continued on the phone without re-entering anything. (UAT TC-25 step 3; UAT TC-25; TFA-94513 AC 11; TFA-94704 AC 5) — gate: blocked: TFA-94513 in progress; TFA-94704 development backlog</li><li><b>U4</b> A note generated on the phone appears on the computer in real time, with no refresh. (UAT TC-25 step 4; UAT TC-25; TFA-94704 AC 5; TFA-94513 AC 11) — gate: blocked: TFA-94513 in progress; TFA-94704 development backlog</li><li><b>U5</b> A patient deleted on the computer disappears from the phone in real time. (UAT TC-25 step 5; UAT TC-25; TFA-94513 AC 18; TFA-94704 AC 5) — gate: blocked: TFA-94513 in progress; TFA-94704 development backlog</li><li><b>U6</b> Steps 2-5 (add, pre-round save, generate, delete) work the same in Nursing Home as in Hospital. (UAT TC-25 step 6; UAT TC-25; UAT 3.3) — gate: blocked: TFA-94513 in progress; TFA-94704 development backlog</li><li><b>T3</b> On the phone app, TC-25's own steps behave as on the web: the same email-code login, and the same add, pre-round save, Generate and delete results. (TFA-94704 AC 5; TFA-92570 What) — gate: blocked: TFA-94704 development backlog</li></ul><p><b>Test design technique: </b>Device (device) — Look at the layout and gestures at phone size or on a real device (iPhone / Pixel).</p><p><b>Given </b>Android emulator with the main debug build pointed at the local stack, signed in with its own email code; desktop Chrome with its own session</p><p><b>When </b>Run S01's steps with the app as the phone, then S02's</p><p><b>Then </b>Same results as S01 and S02 on the real app's WebView</p><p><b>Pass rule (oracle, excerpt): </b>Same checkpoints as S01/S02, read from the WebView page (android-lane screenshots plus text). Until the lane signs in through the app's own form, its run is not evidence for T1 or TFA-94513 AC 10</p><p><b>Where it ran: </b>local newspec-c (new Playwright specs); test method DEVICE · Real device (iOS / Android); lane planned in the matrix: visual / mobile (blocked)</p><p><small>S22 is our own case number (its number in the coverage matrix cases/TC-25.matrix.json), not a step number of the UAT document.</small></p></div><p><b>Environment: local</b> — main e02167f → 43c38a4f (10-15 re-tests), local stack (not a deployed build); run folder <code>runs/2026-10-14-local</code>, lane newspec-c.</p><p><b>Test method:</b> DEVICE · Real device (iOS / Android); secondary: MULTI · Multi-device / multi-account — as classified in cases/test-methods.json, which says it runs on local; Source: <code>newspec-c</code>.</p><p><b>UAT item:</b> TC-25 Web &amp; Phone Sync · <b>Section:</b> A5 · Cross-Cutting · <b>Scenario:</b> TC-25/S22</p><p><b>Android app (debug build on the local stack) and desktop Chrome: steps 2-5 in both modes</b></p><p><b>Tickets:</b> TFA-92570 Mobile: Capacitor wrap for App Store &amp; Google Play (ready for qa); TFA-94513 Signing In &amp; Session Security (in progress); TFA-94704 Production Web App Hosting + PWA (development backlog)</p><p><b>New local lane</b> <code>newspec-c</code>: status <b>passed</b> in <code>newspec-c/results.json</code> → <b>passed</b> (passed).</p><p><b>Detail:</b></p><pre style=\"white-space:pre-wrap\">Android rig: debug build of main e02167f bundled for the LOCAL stack only (bundle names 127.0.0.1:4510/4511, reached through adb reverse), built outside the checkout, on the rc_api36 emulator (Pixel 7, Android 16); Playwright attached to the app's own WebView; every ai/* action the app sends is answered or failed at the WebView's socket (no model call; aiCallLog had no new row in any run). Phone = the app, signed in through its own email-code form (POST 200, its own session); computer = desktop Chromium with a separate session, Hospital (S01 loop) and Nursing Home (S02 loop). T3 (TFA-92570, judged): own-form sign-in, an add made 
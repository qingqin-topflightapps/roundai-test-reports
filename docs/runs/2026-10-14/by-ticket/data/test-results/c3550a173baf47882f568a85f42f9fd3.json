fdb0e9ed27b8a738d3ec256","originalFileName":"52edafe3-5433-44cd-9de4-f7e5d452fb21-attachment.json","ext":".json","contentType":"application/json","contentLength":10134,"name":"newspec-c/evidence/tc24-s23-s28-desktop.json"},"type":"attachment"},{"link":{"id":"6935283f191bf9f2a1dcfd74d1da4909","originalFileName":"e9dfb9d5-16c5-46be-ae42-a379094206f6-attachment.json","ext":".json","name":"newspec-c/evidence/tc24-s23-s28-pixel7.json","contentType":"application/json","used":true,"missed":false,"contentLength":11046},"type":"attachment"},{"link":{"used":true,"missed":false,"id":"16069d575b28e1a83796946174185e84","originalFileName":"c9e1a15b-e069-4613-8f32-d28899fd5129-attachment.json","ext":".json","contentType":"application/json","contentLength":12892,"name":"newspec-c/evidence/tc24-s23-s28-iphone15.json"},"type":"attachment"},{"link":{"used":true,"missed":false,"id":"3d5fde0ea8399780208af53ad1e07991","originalFileName":"0ddf290b-7ddc-4602-b695-243587540ab7-attachment.json","ext":".json","contentType":"application/json","contentLength":3226,"name":"lane result (newspec-c/results.json)"},"type":"attachment"}],"error":{"message":"newspec-c: record-only → passed (record only (every judged cell passed, the rest is recorded only))\nOur own addition: record-only. Web half done, Android-app half blocked (device). Fresh run (newspec-c/vis-tc24-s23-s28-lists-delete.spec.ts) on desktop, Pixel 7 Chromium and iPhone 15 WebKit with two Hospital patients and two residents; it agrees with the existing TC-01/S22 visual evidence (runs/2026-10-14-local/visual/evidence/TC-01_S22). Hospital cards (name, NEW TODAY, 'Room 4B-11 · 72y', diagnosis, 'Not Yet Prepped' + 'Follow-up' badges) and Nursing Home cards on Today's Visits and All Residents (name, unit, DOB, diagnosis, 'Pending' + 'Follow-up', 'In Today ✓'): no truncated or overflowing text and nothing covered on any profile, except low-severity 'under the fixed bottom nav' findings on iPhone 15 for card lines below the fold (scrolling clears them). The hospital day and the Nursing Home visit number are not on the cards at all (known B23, judged in TC-01/S03/S05/S06, not here). The trash icon is 28x28 CSS px (>= 24 px, < 44 pt) and on top at its centre, but it sits inside the card's own role=button open-chart area (nested-interactive, suggestion A3). Not run: the Android app on the emulator (android-lane.ts)."},"testCase":{"id":"dd959a70817d0e7f96dfd61dcb9db121","externalId":"e48226a318b6e0aee99926385f83da4a","name":"[local] S23 Cards on phone width (Pixel 7 Chromium, iPhone 15 WebKit) and the Android app","fullName":"TC-01 Patient Chart Card › TC-01/S23"},"descriptionHtml":"<div class=\"rc-approach\"><p><b>Approach</b> · TC-01 Patient Chart Card · <b>S23</b> Cards on phone width (Pixel 7 Chromium, iPhone 15 WebKit) and the Android app</p><p><b>UAT steps / ticket ACs covered:</b></p><ul><li><b>U1</b> Each patient renders as a card on the home screen showing the patient's first and last name and room (Nursing Home: unit/room). (UAT TC-01; TFA-92579 AC 3)</li><li><b>U2</b> The card shows the chief diagnosis on Hospital cards only; a Nursing Home card shows no diagnosis. (UAT TC-01; TFA-92579 AC 3; UAT TC-03)</li><li><b>U3</b> The card shows age/sex in the &quot;76F&quot; format. (UAT TC-01; TFA-92579 AC 3)</li><li><b>U4</b> The card shows the New Admission / Follow-up / Consult badge. (UAT TC-01; TFA-92579 AC 3)</li><li><b>U5</b> The card shows the hospital day (Hospital) or the visit number (Nursing Home). (UAT TC-01; TFA-92579 AC 3)</li><li><b>T5</b> A patient card can be removed by tapping its trash icon; a pop-up designed like the app UI tells the user what happens if they delete, and the user presses Cancel or OK. (TFA-92579 AC 7)</li></ul><p><b>Test design technique: </b>Device (device) — Look at the layout and gestures at phone size or on a real device (iPhone / Pixel).</p><p><b>Given </b>Visual lane profiles pixel7 and iphone15; android-lane on the emulator</p><p><b>When </b>Open both lists</p><p><b>Then </b>Name, room, diagnosis, badge and day/visit number are not truncated, covered or overflowing; the trash icon is a separate tap target of at least 24 px</p><p><b>Pass rule (oracle, excerpt): </b>visual-lane findings covered/overflow/truncated/tap = 0 on the list screens; findings go to a human (vision-review.sh)</p><p><b>Where it ran: </b>local newspec-c (new Playwright specs); test method VISUAL · Visual (screenshots for a person); lane planned in the matrix: visual / mobile (automated)</p><p><small>S23 is our own case number (its number in the coverage matrix cases/TC-01.matrix.json), not a step number of the UAT document.</small></p></div><p><b>Environment: local</b> — main e02167f, local stack (not a deployed build); run folder <code>runs/2026-10-14-local</code>, lane newspec-c.</p><p><b>Test method:</b> VISUAL · Visual (screenshots for a person); secondary: DEVICE · Real device (iOS / Android) — as classified in cases/test-methods.json, which says it runs on both (web widths); Source: <code>newspec-c</code>.</p><p><b>UAT item:</b> TC-01 Patient Chart Card · <b>Section:</b> A1 · Home Screen &amp; Dashboard · <b>Scenario:</b> TC-01/S23</p><p><b>Cards on phone width (Pixel 7 Chromium, iPhone 15 WebKit) and the Android app</b></p><p><b>Tickets:</b> TFA-92579 Home Screen: Patient Chart Card (ready for qa)</p><p><b>New local lane</b> <code>newspec-c</code>: status <b>record-only</b> in <code>newspec-c/results.json</code> → <b>passed</b> (record only (every judged cell passed, the rest is recorded only)).</p><p><b>Detail:</b></p><pre style=\"white-space:pre-wrap\">Our own addition: record-only. Web half done, Android-app half blocked (device). Fresh run (newspec-c/vis-tc24-s23-s28-lists-delete.spec.ts) on desktop, Pixel 7 Chromium and iPhone 15 WebKit with two Hospital patients and two residents; it agrees with the existing TC-01/S22 visual evidence (runs/2026-10-14-local/visual/evidence/TC-01_S22). Hospital cards (name, NEW TODAY, 'Room 4B-11 · 72y', diagnosis, 'Not Yet Prepped' + 'Follow-up' badges) and Nursing Home cards on Today's Visits and All Residents (name, unit, DOB, diagnosis, 'Pending' + 'Follow-up', 'In Today ✓'): no truncated or overflowing text and nothing covered on any profile, except low-severity 'under the fixed bottom nav' findings on iPhone 15 for card lines below the fold (scrolling clears them). The hospital day and the Nursing Home visit number are not on the cards at all (known B23, judged in TC-01/S03/S05/S06, not here). The trash icon is 28x28 CSS px (&gt;= 24 px, &lt; 44 pt) and on top at its centre, but it sits inside the card's own role=button open-chart area (nested-interactive, suggestion A3). Not run: the Android app on the emulator (android-lane.ts).</pre><p><b>Evidence:</b> 21 attached.</p><p><b>Dev run:</b> skipped: set-aside — set-aside: iOS/Android (Quinn 2026-10-14) — Needs the Android app on the emulator (android-lane.ts); iOS and Android are set aside for the dev run (Quinn 2026-10-14).. This local result replaces that dev entry (the scenario appears once).</p>","environment":"default","setup":[],"teardown":[],"history":[],"retries":[],"breadcrumbs":[["TC-01 Patient Chart Card","S23 Cards on phone width (Pixel 7 Chromium, iPhone 15 WebKit) and the Android app"]],"retry":false,"titlePath":[],"retriesCount":0,"attachments":[{"link":{"id":"86d2c8eb93dade9b93abb1134bd56207","originalFileName":"fd0084a8-86db-4978-808c-746eb4028e84-attachment.json","ext":".json","name":"newspec-c/evidence/tc24-s23-s28-desktop-hospital-list.json","contentType":"application/json","used":true,"missed":false,"contentLength":2497},"type":"attachment"},{"link":{"used":true,"missed":false,"id":"d577be5d624713e5affeb629e9c93c6a","originalFileName":"0da1841e-6fb7-47a5-bce1-7a50ce77a9ae-attachment.png","ext":".png","contentType":"image/png","contentLength":79746,"name":"newspec-c/evidence/tc24-s23-s28-desktop-hospital-list.png"},"type":"attachment"},{"link":{"id":"64535dc52102b66f829730fa9d3e326e","originalF
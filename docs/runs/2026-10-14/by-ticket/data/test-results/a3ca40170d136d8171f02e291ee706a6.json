.png","ext":".png","name":"newspec-c/evidence/dvc-tc25-s22-snf-04a-phone-encounter.device.png","contentType":"image/png","used":true,"missed":false,"contentLength":181089},"type":"attachment"},{"link":{"used":true,"missed":false,"id":"f1a5802a0a80abfc278801cde1cb50a5","originalFileName":"38b49497-1733-4655-bd2c-500e947e8a52-attachment.png","ext":".png","contentType":"image/png","contentLength":187346,"name":"newspec-c/evidence/dvc-tc25-s22-snf-04b-phone-after-generate.device.png"},"type":"attachment"},{"link":{"id":"db6267e949a55ef43ce1793c1a90bad7","originalFileName":"ba37b42a-6472-4783-9376-2ad11b6de378-attachment.png","ext":".png","name":"newspec-c/evidence/dvc-tc25-s22-snf-04c-computer-post-round.png","contentType":"image/png","used":true,"missed":false,"contentLength":73051},"type":"attachment"},{"link":{"id":"d0904bcbddcc1d4307daeb81330060af","originalFileName":"e613f0c3-1ff3-477e-a571-199a6fe43e56-attachment.png","ext":".png","name":"newspec-c/evidence/dvc-tc25-s22-snf-05a-phone-list-before-delete.device.png","contentType":"image/png","used":true,"missed":false,"contentLength":227455},"type":"attachment"},{"link":{"used":true,"missed":false,"id":"6c60293f9598233cea5f38202512313a","originalFileName":"374f1e58-d55d-4bd9-bf9e-559060f27ad4-attachment.png","ext":".png","contentType":"image/png","contentLength":226054,"name":"newspec-c/evidence/dvc-tc25-s22-snf-05b-phone-list-after-delete.device.png"},"type":"attachment"},{"link":{"id":"4282ed51247e736f8a215748f12379e0","originalFileName":"fc0c8c11-2d53-47ac-a62f-47d6fe62e3d5-attachment.json","ext":".json","name":"newspec-c/evidence/dvc-tc25-s22-snf.json","contentType":"application/json","used":true,"missed":false,"contentLength":4646},"type":"attachment"},{"link":{"used":true,"missed":false,"id":"a683acabd5cfa1943c80590f65f701e5","originalFileName":"2498f48b-5675-4bf0-9121-eb9e92bd29c8-attachment.json","ext":".json","contentType":"application/json","contentLength":6103,"name":"lane result (newspec-c/results.json)"},"type":"attachment"}],"error":{"message":"newspec-c: passed → passed (passed)\nAndroid rig: debug build of main e02167f bundled for the LOCAL stack only (bundle names 127.0.0.1:4510/4511, reached through adb reverse), built outside the checkout, on the rc_api36 emulator (Pixel 7, Android 16); Playwright attached to the app's own WebView; every ai/* action the app sends is answered or failed at the WebView's socket (no model call; aiCallLog had no new row in any run). Phone = the app, signed in through its own email-code form (POST 200, its own session); computer = desktop Chromium with a separate session, Hospital (S01 loop) and Nursing Home (S02 loop). T3 (TFA-92570, judged): own-form sign-in, an add made in the app is stored and listed like a web add, the computer's pre-round save reaches the app's chart the same way it reaches a second web session, Generate in the app (scripted note) stores and shows the note, and a delete on the computer removes the patient for the app: Hospital 8/8, Nursing Home 6/6 judged checks (no resident delete control exists on web or app: known B24 / Q3). Recorded only (U1-U6, gated TFA-94513 in progress / TFA-94704 backlog): the computer stayed signed in after the phone's sign-in; the phone's add showed on the computer without a refresh (3 ms / 309 ms); the phone's note showed on the computer's Post-Round without a refresh; the delete reached the phone in 322 ms; Nursing Home pre-round text and BP showed live on the phone. Hospital: the computer's saved pre-round TEXT did not appear on the app's open chart (nor on a second…"},"testCase":{"id":"145f3434094513f2e0cd0948424c90e3","externalId":"34a8cb925152b3e652a2ad4d807bb1dd","name":"[local] S22 Android app (debug build on the local stack) and desktop Chrome: steps 2-5 in both modes","fullName":"TC-25 Web & Phone Sync › TC-25/S22"},"descriptionHtml":"<p><b>Case priority: P0 · stated in the UAT / ticket AC</b> · UAT TC-25 step 1 ('on a phone (app)'); TFA-94704 AC 5 · “Sign in with the same account on a phone (app) and a computer (web), each with its own email code.”.</p><div class=\"rc-approach\"><p><b>Approach</b> · TC-25 Web &amp; Phone Sync · <b>S22</b> Android app (debug build on the local stack) and desktop Chrome: steps 2-5 in both modes</p><p><b>UAT steps / ticket ACs covered:</b></p><ul><li><b>U1</b> The same account is signed in on a phone (app) and a computer (web) at the same time. Signing in on one does not sign out the other, and both stay signed in. (UAT TC-25 step 1; UAT TC-25; TFA-94513 AC 9; TFA-94704 AC 5) — gate: blocked: TFA-94513 in progress; TFA-94704 development backlog</li><li><b>U2</b> A patient added on the phone appears on the computer in real time, with no refresh or re-entry. (UAT TC-25 step 2; UAT TC-25; TFA-94704 AC 5; TFA-94513 AC 11) — gate: blocked: TFA-94513 in progress; TFA-94704 development backlog</li><li><b>U3</b> A pre-round note dictated and saved on the computer appears on the phone in real time, with no refresh, and can be continued on the phone without re-entering anything. (UAT TC-25 step 3; UAT TC-25; TFA-94513 AC 11; TFA-94704 AC 5) — gate: blocked: TFA-94513 in progress; TFA-94704 development backlog</li><li><b>U4</b> A note generated on the phone appears on the computer in real time, with no refresh. (UAT TC-25 step 4; UAT TC-25; TFA-94704 AC 5; TFA-94513 AC 11) — gate: blocked: TFA-94513 in progress; TFA-94704 development backlog</li><li><b>U5</b> A patient deleted on the computer disappears from the phone in real time. (UAT TC-25 step 5; UAT TC-25; TFA-94513 AC 18; TFA-94704 AC 5) — gate: blocked: TFA-94513 in progress; TFA-94704 development backlog</li><li><b>U6</b> Steps 2-5 (add, pre-round save, generate, delete) work the same in Nursing Home as in Hospital. (UAT TC-25 step 6; UAT TC-25; UAT 3.3) — gate: blocked: TFA-94513 in progress; TFA-94704 development backlog</li><li><b>T3</b> On the phone app, TC-25's own steps behave as on the web: the same email-code login, and the same add, pre-round save, Generate and delete results. (TFA-94704 AC 5; TFA-92570 What) — gate: blocked: TFA-94704 development backlog</li></ul><p><b>Test design technique: </b>Device (device) — Look at the layout and gestures at phone size or on a real device (iPhone / Pixel).</p><p><b>Given </b>Android emulator with the main debug build pointed at the local stack, signed in with its own email code; desktop Chrome with its own session</p><p><b>When </b>Run S01's steps with the app as the phone, then S02's</p><p><b>Then </b>Same results as S01 and S02 on the real app's WebView</p><p><b>Pass rule (oracle, excerpt): </b>Same checkpoints as S01/S02, read from the WebView page (android-lane screenshots plus text). Until the lane signs in through the app's own form, its run is not evidence for T1 or TFA-94513 AC 10</p><p><b>Where it ran: </b>local newspec-c (new Playwright specs); test method DEVICE · Real device (iOS / Android); lane planned in the matrix: visual / mobile (blocked)</p><p><small>S22 is our own case number (its number in the coverage matrix cases/TC-25.matrix.json), not a step number of the UAT document.</small></p></div><p><b>Environment: local</b> — main e02167f → 8b4be94a (10-20), local stack (not a deployed build); run folder <code>runs/2026-10-14-local</code>, lane newspec-c.</p><p><b>Test method:</b> DEVICE · Real device (iOS / Android); secondary: MULTI · Multi-device / multi-account — as classified in cases/test-methods.json, which says it runs on local; Source: <code>newspec-c</code>.</p><p><b>UAT item:</b> TC-25 Web &amp; Phone Sync · <b>Section:</b> A5 · Cross-Cutting · <b>Scenario:</b> TC-25/S22</p><p><b>Android app (debug build on the local stack) and desktop Chrome: steps 2-5 in both modes</b></p><p><b>Tickets:</b> TFA-92570 Mobile: Capacitor wrap for App Store &amp; Google Play (ready for qa); TFA-94513 Signing In &amp; Session Security (in progress); TFA-94704 Production Web App Hosting + PWA (development backlog)</p><p><b>New local lane</b> <code>newspec-c</code>: status <b>passed</b> in <code>newspec-c/results.json</code> → <b>passed</b> (passed).</p><p><b>Detail:</b></p><pre style=\"white-space:pre-wrap\">Android rig: debug build of main e02167f bundled for the LOCAL stack only (bundle names 127.0.0.1:4510/4511, reached through adb reverse), built outside the checkout, on the rc_api36 emulator (Pixel 7, Android 16); Playwright attached to the app's own WebView; every ai/* action the app sends is answered or failed at the WebView's socket (no model call; aiCallLog had no new row in any run). Phone = the app, signed in through its own email-code form (POST 200, its own session); computer = desktop Chromium with a separate session, Hospital (S01 loop) and Nursing Home (S02 loop). T3 (TFA-92570, judged): own-form sign-in, an add made in the app is stored and listed like a web add, the computer's pre-round save reaches the app's chart the same way it reaches a second web session, Generate in the app (scripted note) stores and shows the note, and a delete on the computer removes the patient for the app: Hospital 8/8, Nursing Home 6/6 judged checks (no resident delete control exists on web or app: known B24 / Q3). Recorded only (U1-U6, gated TFA-94513 in progress / TFA-94704 backlog): the computer stayed signed in after the phone's sign-in; the phone's add showed on the computer without a refresh (3 ms / 309 ms); the phone's note showed on the computer's Post-Round without a refresh; the delete reached the phone in 322 ms; Nursing Home pre-round text and BP showed live on the phone. Hospital: the computer's saved pre-round TEXT did not appear on the app's open chart (nor on a second web session; the panel BP did, in ~0.3 s) until the chart was reopened, and a follow-up probe (dvc-tc25-s22-probe-stale-preround) showed that typing into that stale empty box on the phone replaced the computer's saved note on the server (see newFindings). Note: the 01:46 run's tripwire line 'FORBIDDEN notes.generateNote +16' came from the old count-based tripwire reading a partial table at mark time; aiCallLog had no row newer than 09:00:54Z at all (checked), and the tripwire is now time-based.</pre><p><b>Evidence:</b> 38 attached.</p><p><b>Dev run:</b> skipped: set-aside — set-aside: iOS/Android (Quinn 2026-10-14) — Needs the Android app (the debug build on the emulator, android-lane.ts) as the phone; iOS and Android are set aside for the dev run (Quinn 2026-10-14).. This local result replaces that dev entry (the scenario appears once).</p>","environment":"default","setup":[],"teardown":[],"history":[],"retries":[],"breadcrumbs":[["TC-25 Web & Phone Sync","S22 Android app (debug build on the local stack) and desktop Chrome: steps 2-5 in both modes"]],"retry":false,"titlePath":[],"retriesCount":0,"attachments":[{"link":{"id":"815ffad8613c021ad438bf9a9d48564e","originalFileName":"d36d79d9-8106-4cb8-94d1-41aaffe610c2-attachment.png","ext":".png","name":"newspec-c/evidence/dvc-tc25-s22-hospital-01-phone-signed-in.device.png","contentType":"image/png","used":true,"missed":false,"contentLength":196254},"type":"attachment"},{"link":{"id":"614ad9dc008cb7d06f190a53a609472d","originalFileName":"f61f01a5-1715-4fe4-8c4e-7721bf51381e-attachment.png","ext":".png","name":"newspec-c/evidence/dvc-tc25-s22-hospital-02a-phone-add-form.device.png","contentType":"image/png","used":true,"missed":false,"contentLength":190772},"type":"attachment"},{"link":{"id":"5f3c010ad7da34531d4bc5d5adb064cf","originalFileName":"ac8f3aaf-8ac0-4791-9f37-36fe950c5802-attachment.png","ext":".png","name":"newspec-c/evidence/dvc-tc25-s22-hospital-02b-phone-after-add.device.png","contentType":"image/png","used":true,"missed":false,"contentLength":228105},"type":"attachment"},{"link":{"used":true,"missed":false,"id":"87d4183be2fe565a79927a83c4883678","originalFileName":"53cfaf6a-4b85-4465-b802-3d2b8e757b47-attachment.png","ext":".png","contentType":"image/png","contentLength":97873,"name":"newspec-c/evidence/dvc-tc25-s22-hospital-02c-computer-after-p
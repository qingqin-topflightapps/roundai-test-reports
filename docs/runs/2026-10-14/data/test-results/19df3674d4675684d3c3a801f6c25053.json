c04f66dbc1ba9cf37e871","originalFileName":"db3a7fd1-6334-496c-8b90-1570af49ec9a-attachment.txt","ext":".txt","name":"page snapshot (accessibility tree)","contentType":"text/plain","used":true,"missed":false,"contentLength":2700},"type":"attachment"},{"link":{"used":true,"missed":false,"id":"76e864503ffd059903b4ed6e6594ddd0","originalFileName":"64fe32ae-f119-4a01-b8ae-144383f60f13-attachment.png","ext":".png","contentType":"image/png","contentLength":57078,"name":"screenshot"},"type":"attachment"}],"parameters":[],"start":1791939349340,"stop":1791939349340,"duration":0,"type":"step","hasSimilarErrorInSubSteps":false},{"stepId":"388601ed5504047abc8fbceab764afbf","name":"s01-list-after.md (/rounding): Pass","status":"passed","steps":[{"link":{"id":"028eaa3036903423b0c4e3206163c517","originalFileName":"eb64750f-774a-4d17-a9b0-3acd3be4a0bd-attachment.txt","ext":".txt","name":"page snapshot (accessibility tree)","contentType":"text/plain","used":true,"missed":false,"contentLength":2532},"type":"attachment"},{"link":{"used":true,"missed":false,"id":"92c5f873a0c6b19198e86db7818a5ad1","originalFileName":"ba568ca6-b2c5-420d-863a-401b456750a3-attachment.png","ext":".png","contentType":"image/png","contentLength":78572,"name":"screenshot"},"type":"attachment"}],"parameters":[],"start":1791939349340,"stop":1791939349340,"duration":0,"type":"step","hasSimilarErrorInSubSteps":false},{"link":{"id":"eba866ec27ffa0461c68099fa55fe8f2","originalFileName":"d8f70c93-40ff-43cc-b451-df842ce1bc26-attachment.txt","ext":".txt","name":"agent's notes (facts it saw, not a verdict)","contentType":"text/plain","used":true,"missed":false,"contentLength":2315},"type":"attachment"},{"link":{"used":true,"missed":false,"id":"1d04e4f4fef8d8477d4a3ed5009a4f84","originalFileName":"6a608625-dd0a-49bf-957f-ca2c44ae2f78-attachment.json","ext":".json","contentType":"application/json","contentLength":4674,"name":"oracle verdict"},"type":"attachment"}],"error":{"message":"Checked by Quinn's runner (ledger.md #61): Pass — UAT TC-06 main flow both modes: add form toggle (default Follow-up), template preselected per badge, hand override, reload, list badge"},"testCase":{"id":"9da6d2ad1c02d5ceff7608434e0e4545","externalId":"bd02294770af9706e1d555d440b1bd94","name":"[dev] S01 Hospital walk: add-form default, list badge, three states by hand, pre-selection per state, override, reload","fullName":"TC-06 Admission Status Toggle › TC-06/S01"},"descriptionHtml":"<div class=\"rc-approach\"><p><b>Approach</b> · TC-06 Admission Status Toggle · <b>S01</b> Hospital walk: add-form default, list badge, three states by hand, pre-selection per state, override, reload</p><p><b>UAT steps / ticket ACs covered:</b></p><ul><li><b>U1</b> Nothing is ever New Admission (or Consult) unless the physician set it: the app never guesses the status, and a patient nobody has set reads Follow-up (UAT TC-06)</li><li><b>U3</b> The manual add form has the three-state toggle (New Admission / Follow-up / Consult) at creation, it defaults to Follow-up, and the state chosen there (or left untouched) is the one saved (UAT TC-06; TFA-92584 AC 2; TFA-92584 AC 3)</li><li><b>U4</b> The physician can change the badge by hand at any time (before or after Generate, and on a patient whose status already rolled) through all three states, and each change persists (list, chart, reload … (UAT TC-06; TFA-92584 AC 1)</li><li><b>U8</b> The badge pre-selects the template at Generate: Hospital New Admission -&gt; H&amp;P, Follow-up -&gt; SOAP progress, Consult -&gt; Consult note; … (UAT TC-06; TFA-92584 AC 6; TFA-92584 AC 7)</li><li><b>U9</b> The physician still sees the template picker at Generate and can change the pre-selected template by hand; changing the template does not change the badge, and Generate writes the note in the templat … (UAT TC-06; TFA-92584 AC 6)</li><li><b>U12</b> All of the above works in both Hospital and Nursing Home (step 7, ground rule 3.3) (UAT TC-06; UAT 3.3; TFA-92584 AC 7)</li><li><b>T2</b> Discharge templates (Discharge summary; SNF discharge once it exists) are never pre-selected by the badge in either context; they are only chosen by hand (UAT TC-06 step 6) (UAT TC-06; TFA-92584 AC 6; TFA-92599 AC 6)</li></ul><p><b>Test design technique: </b>Happy path (happy-path) — Walk the normal flow exactly as the UAT / ticket words it; everything it names has to show up.</p><p><b>Given </b>Fresh @roundai.test physician with the session fixture: one Hospital patient nobody has set a status for</p><p><b>When </b>Look at the untouched Add Patient form; open the patient's chart; on the Encounter tab set the badge to New Admission, then Consult; with Consult set, change Note Format by hand to SOAP progress; reload; go back to the list</p><p><b>Then </b>Add form offers all three states with Follow-up selected; the untouched patient is Follow-up with SOAP progress pre-selected; New Admission -&gt; H&amp;P; Consult -&gt; Consult note; Discharge summary is never the pre-selected template; the template override does not change the badge; Consult survives the reload and shows on the list</p><p><b>Pass rule (oracle, excerpt): </b>UAT TC-06 Expected Result + TFA-92584 AC 1, 3, 6. oracle.mjs per checkpoint; native selects list every option even when closed, so the checks are on which option is [selected] (calibrated in TC-21 S05). Discharge checks belong to T2 (not gated: UAT TC-06 + TFA-92584 AC 6). …</p><p><b>Where it ran: </b>dev unit U61; test method AGENT · Browser agent; lane planned in the matrix: browser agent (automated)</p><p><small>S01 is our own case number (its number in the coverage matrix cases/TC-06.matrix.json), not a step number of the UAT document.</small></p></div><p><b>Environment: dev</b> — dev deployment, build <code>e02167f</code> (Deploy Convex, 2026-10-12T18:24:27Z); account and address are not written into the report; run folder <code>runs/2026-10-14-dev</code>.</p><p><b>Test method:</b> AGENT · Browser agent; secondary: PW · Playwright script — as classified in cases/test-methods.json, which says it runs on both; Source: <code>dev</code>.</p><p><b>UAT item:</b> TC-06 Admission Status Toggle · <b>Section:</b> A1 · Home Screen &amp; Dashboard · <b>Scenario:</b> TC-06/S01</p><p><b>Hospital walk: add-form default, list badge, three states by hand, pre-selection per state, override, reload</b></p><p><b>Tickets:</b> TFA-92584 Admission Status Toggle (ready for qa); TFA-92599 Hospital vs. Nursing-Home Context Switch (in progress)</p><p><b>Result:</b> Pass from <code>scripts/oracle.mjs</code> on the saved evidence (<code>units/U61.verdict.json</code>), unit U61 split by its parts' checkpoints. Agent: 88 turns, 217 s, $0.66.</p><p><b>Plan:</b> unit U61 (#51, rest, ui-only) — Badge walk with template pre-selection. Same legacy seed, same controls; S01 works only the Hospital patient and S02 only the resident, so neither touches the other's chart. Runs together with TC-06/S02.</p><p><b>Checked by Quinn's runner</b> (<code>ledger.md</code> #61, U61; checked: yes): <b>Pass</b> — UAT TC-06 main flow both modes: add form toggle (default Follow-up), template preselected per badge, hand override, reload, list badge</p>","environment":"default","setup":[],"teardown":[],"history":[],"retries":[],"breadcrumbs":[["TC-06 Admission Status Toggle","S01 Hospital walk: add-form default, list badge, three states by hand, pre-selection per state, overrid…"]],"retry":false,"titlePath":[],"retriesCount":0,"attachments":[{"link":{"used":true,"missed":false,"id":"51fc61b6aae5c87098ea5ddcd8ac0275","originalFileName":"60336f69-b692-458f-bd13-3fe19c79ed41-attachment.txt","ext":".txt","contentType":"text/plain","contentLength":4242,"name":"page snapshot (accessibility tree)"},"type":"attachment"},{"link":{"used":true,"missed":false,"id":"ac233abd9853f735da18b30fdede0b64","originalFileName":"51b5c02f-7efb-46fb-963b-42cf9a193642-attachment.png","ext":".png","contentType":"image/png","contentLength":68343,"name":"screenshot"},"type":"attachment"},{"link
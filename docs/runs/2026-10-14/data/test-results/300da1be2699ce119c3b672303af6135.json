.png","ext":".png","name":"newspec-c/evidence/dvc-tc25-s22-snf-04a-phone-encounter.device.png","contentType":"image/png","used":true,"missed":false,"contentLength":181089},"type":"attachment"},{"link":{"id":"cbc97b2cdb798e39bf8533fe276b0cc4","originalFileName":"f8f97e8f-af00-4432-913e-b1185fc975e6-attachment.png","ext":".png","name":"newspec-c/evidence/dvc-tc25-s22-snf-04b-phone-after-generate.device.png","contentType":"image/png","used":true,"missed":false,"contentLength":187346},"type":"attachment"},{"link":{"id":"dadd58bbdbd4d02b18ca9d2ba82595b1","originalFileName":"b4c5c000-e6b3-4dfd-a46a-bcc0a5bfb792-attachment.png","ext":".png","name":"newspec-c/evidence/dvc-tc25-s22-snf-04c-computer-post-round.png","contentType":"image/png","used":true,"missed":false,"contentLength":73051},"type":"attachment"},{"link":{"id":"570cddc898aa98e0c82d62a88289006f","originalFileName":"56c71388-2d63-4f67-85e5-253ab6366b30-attachment.png","ext":".png","name":"newspec-c/evidence/dvc-tc25-s22-snf-05a-phone-list-before-delete.device.png","contentType":"image/png","used":true,"missed":false,"contentLength":227455},"type":"attachment"},{"link":{"id":"6918ec64b5d1718c471dde2fc17256cd","originalFileName":"27dd7247-faab-45d4-9d08-f1a80b75f6d7-attachment.png","ext":".png","name":"newspec-c/evidence/dvc-tc25-s22-snf-05b-phone-list-after-delete.device.png","contentType":"image/png","used":true,"missed":false,"contentLength":226054},"type":"attachment"},{"link":{"id":"e6a6b47ce7a1be6f7aa9a5f4fc265b4e","originalFileName":"f19eb9ed-207b-43c9-a398-71b0c7392f6d-attachment.json","ext":".json","name":"newspec-c/evidence/dvc-tc25-s22-snf.json","contentType":"application/json","used":true,"missed":false,"contentLength":4646},"type":"attachment"},{"link":{"id":"537369bfd3cf83ce2758676ed8c25397","originalFileName":"59c64352-5504-4613-91fb-2620cd2467dc-attachment.json","ext":".json","name":"lane result (newspec-c/results.json)","contentType":"application/json","used":true,"missed":false,"contentLength":6103},"type":"attachment"}],"error":{"message":"newspec-c: passed → passed (passed)\nAndroid rig: debug build of main e02167f bundled for the LOCAL stack only (bundle names 127.0.0.1:4510/4511, reached through adb reverse), built outside the checkout, on the rc_api36 emulator (Pixel 7, Android 16); Playwright attached to the app's own WebView; every ai/* action the app sends is answered or failed at the WebView's socket (no model call; aiCallLog had no new row in any run). Phone = the app, signed in through its own email-code form (POST 200, its own session); computer = desktop Chromium with a separate session, Hospital (S01 loop) and Nursing Home (S02 loop). T3 (TFA-92570, judged): own-form sign-in, an add made in the app is stored and listed like a web add, the computer's pre-round save reaches the app's chart the same way it reaches a second web session, Generate in the app (scripted note) stores and shows the note, and a delete on the computer removes the patient for the app: Hospital 8/8, Nursing Home 6/6 judged checks (no resident delete control exists on web or app: known B24 / Q3). Recorded only (U1-U6, gated TFA-94513 in progress / TFA-94704 backlog): the computer stayed signed in after the phone's sign-in; the phone's add showed on the computer without a refresh (3 ms / 309 ms); the phone's note showed on the computer's Post-Round without a refresh; the delete reached the phone in 322 ms; Nursing Home pre-round text and BP showed live on the phone. Hospital: the computer's saved pre-round TEXT did not appear on the app's open chart (nor on a second…"},"testCase":{"id":"145f3434094513f2e0cd0948424c90e3","externalId":"34a8cb925152b3e652a2ad4d807bb1dd","name":"[local] S22 Android app (debug build on the local stack) and desktop Chrome: steps 2-5 in both modes","fullName":"TC-25 Web & Phone Sync › TC-25/S22"},"descriptionHtml":"<p><b>Case priority: P0 · stated in the UAT / ticket AC</b> · UAT TC-25 step 1 ('on a phone (app)'); TFA-94704 AC 5 · “Sign in with the same account on a phone (app) and a computer (web), each with its own email code.”.</p><div class=\"rc-approach\"><p><b>Approach</b> · TC-25 Web &amp; Phone Sync · <b>S22</b> Android app (debug build on the local stack) and desktop Chrome: steps 2-5 in both modes</p><p><b>UAT steps / ticket ACs covered:</b></p><ul><li><b>U1</b> The same account is signed in on a phone (app) and a computer (web) at the same time. Signing in on one does not sign out the other, and both stay signed in. (UAT TC-25 step 1; UAT TC-25; TFA-94513 AC 9; TFA-94704 AC 5) — gate: blocked: TFA-94513 in progress; TFA-94704 development backlog</li><li><b>U2</b> A patient added on the phone appears on the computer in real time, with no refresh or re-entry. (UAT TC-25 step 2; UAT TC-25; TFA-94704 AC 5; TFA-94513 AC 11) — gate: blocked: TFA-94513 in progress; TFA-94704 development backlog</li><li><b>U3</b> A pre-round note dictated and saved on the computer appears on the phone in real time, with no refresh, and can be continued on the phone without re-entering anything. (UAT TC-25 step 3; UAT TC-25; TFA-94513 AC 11; TFA-94704 AC 5) — gate: blocked: TFA-94513 in progress; TFA-94704 development backlog</li><li><b>U4</b> A note generated on the phone appears on the computer in real time, with no refresh. (UAT TC-25 step 4; UAT TC-25; TFA-94704 AC 5; TFA-94513 AC 11) — gate: blocked: TFA-94513 in progress; TFA-94704 development backlog</li><li><b>U5</b> A patient deleted on the computer disappears from the phone in real time. (UAT TC-25 step 5; UAT TC-25; TFA-94513 AC 18; TFA-94704 AC 5) — gate: blocked: TFA-94513 in progress; TFA-94704 development backlog</li><li><b>U6</b> Steps 2-5 (add, pre-round save, generate, delete) work the same in Nursing Home as in Hospital. (UAT TC-25 step 6; UAT TC-25; UAT 3.3) — gate: blocked: TFA-94513 in progress; TFA-94704 development backlog</li><li><b>T3</b> On the phone app, TC-25's own steps behave as on the web: the same email-code login, and the same add, pre-round save, Generate and delete results. (TFA-94704 AC 5; TFA-92570 What) — gate: blocked: TFA-94704 development backlog</li></ul><p><b>Test design technique: </b>Device (device) — Look at the layout and gestures at phone size or on a real device (iPhone / Pixel).</p><p><b>Given </b>Android emulator with the main debug build pointed at the local stack, signed in with its own email code; desktop Chrome with its own session</p><p><b>When </b>Run S01's steps with the app as the phone, then S02's</p><p><b>Then </b>Same results as S01 and S02 on the real app's WebView</p><p><b>Pass rule (oracle, excerpt): </b>Same checkpoints as S01/S02, read from the WebView page (android-lane screenshots plus text). Until the lane signs in through the app's own form, its run is not evidence for T1 or TFA-94513 AC 10</p><p><b>Where it ran: </b>local newspec-c (new Playwright specs); test method DEVICE · Real device (iOS / Android); lane planned in the matrix: visual / mobile (blocked)</p><p><small>S22 is our own case number (its number in the coverage matrix cases/TC-25.matrix.json), not a step number of the UAT document.</small></p></div><p><b>Environment: local</b> — main e02167f → 8b4be94a (10-20), local stack (not a deployed build); run folder <code>runs/2026-10-14-local</code>, lane newspec-c.</p><p><b>Test method:</b> DEVICE · Real device (iOS / Android); secondary: MULTI · Multi-device / multi-account — as classified in cases/test-methods.json, which says it runs on local; Source: <code>newspec-c</code>.</p><p><b>UAT item:</b> TC-25 Web &amp; Phone Sync · <b>Section:</b> A5 · Cross-Cutting · <b>Scenario:</b> TC-25/S22</p><p><b>Android app (debug build on the local stack) and desktop Chrome: steps 2-5 in both modes</b></p><p><b>Tickets:</b> TFA-92570 Mobile: Capacitor wrap for App Store &amp; Google Play (ready for qa); TFA-94513 Signing In &amp; Session Security (in progress); TFA-94704 Production Web App Hosting + PWA (development backlog)</p><p><b>New local lane</b> <code>newspec-c</code>: status <b>passed</b> in <code>newspec-c/results.json</code> → <b>passed</b> (passed).</p><p><b>Detail:</b></p><pre style=\"white-space:pre-wrap\">Android rig: debug build of main e02167f bundled for the LOCAL stack only (bundle names 127.0.0.1:4510/4511, reached through adb reverse), built outside the checkout, on the rc_api36 emulator (Pixel 7, Android 16); Playwright attached to the app's own WebView; every ai/* action the app sends is answered or failed at the WebView's socket (no model call; aiCallLog had no new row in any run). Phone = the app, signed in through its own email-code form (POST 200, its own session); computer = desktop Chromium with a separate session, Hospital (S01 loop) and Nursing Home (S02 loop). T3 (TFA-92570, judged): own-form sign-in, an add made in the app is stored and listed like a web add, the computer's pre-round save reaches the app's chart the same way it reaches a second web session, Generate in the app (scripted note) stores and shows the note, and a delete on the computer removes the patient for the app: Hospital 8/8, Nursing Home 6/6 judged checks (no resident delete control exists on web or app: known B24 / Q3). Recorded only (U1-U6, gated TFA-94513 in progress / TFA-94704 backlog): the computer stayed signed in after the phone's sign-in; the phone's add showed on the computer without a refresh (3 ms / 309 ms); the phone's note showed on the computer's Post-Round without a refresh; the delete reached the phone in 322 ms; Nursing Home pre-round text and BP showed live on the phone. Hospital: the computer's saved pre-round TEXT did not appear on the app's open chart (nor on a second web session; the panel BP did, in ~0.3 s) until the chart was reopened, and a follow-up probe (dvc-tc25-s22-probe-stale-preround) showed that typing into that stale empty box on the phone replaced the computer's saved note on the server (see newFindings). Note: the 01:46 run's tripwire line 'FORBIDDEN notes.generateNote +16' came from the old count-based tripwire reading a partial table at mark time; aiCallLog had no row newer than 09:00:54Z at all (checked), and the tripwire is now time-based.</pre><p><b>Evidence:</b> 38 attached.</p><p><b>Dev run:</b> skipped: set-aside — set-aside: iOS/Android (Quinn 2026-10-14) — Needs the Android app (the debug build on the emulator, android-lane.ts) as the phone; iOS and Android are set aside for the dev run (Quinn 2026-10-14).. This local result replaces that dev entry (the scenario appears once).</p>","environment":"default","setup":[],"teardown":[],"history":[],"retries":[],"breadcrumbs":[["TC-25 Web & Phone Sync","S22 Android app (debug build on the local stack) and desktop Chrome: steps 2-5 in both modes"]],"retry":false,"titlePath":[],"retriesCount":0,"attachments":[{"link":{"id":"938e20abab187bb97400f06a4fc8566b","originalFileName":"ba4b8f6e-b4b4-47a3-9265-ffc79df14880-attachment.png","ext":".png","name":"newspec-c/evidence/dvc-tc25-s22-hospital-01-phone-signed-in.device.png","contentType":"image/png","used":true,"missed":false,"contentLength":196254},"type":"attachment"},{"link":{"used":true,"missed":false,"id":"b75c7c461e120e3887361c94b04f061a","originalFileName":"0920e5f3-daa3-49d0-9248-f1974c889950-attachment.png","ext":".png","contentType":"image/png","contentLength":190772,"name":"newspec-c/evidence/dvc-tc25-s22-hospital-02a-phone-add-form.device.png"},"type":"attachment"},{"link":{"id":"3026f0f839e8da28d21ec7f177f721e5","originalFileName":"64bcaa50-f1ae-4840-8db8-9b8314b0aa88-attachment.png","ext":".png","name":"newspec-c/evidence/dvc-tc25-s22-hospital-02b-phone-after-add.device.png","contentType":"image/png","used":true,"missed":false,"contentLength":228105},"type":"attachment"},{"link":{"id":"695e4bc60c10e5e78f9c863f28b459d7","originalFileName":"df779048-4de4-45d8-90d5-a30d4c2ddd43-attachment.png","ext":".png","name":"newspec-c/evidence/dvc-tc25-s22-hospital-02c-computer-after-phone-add.png","contentType":"image/png","used":true,"missed":false,"content
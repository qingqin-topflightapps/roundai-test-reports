ssed":false,"contentLength":214511},"type":"attachment"},{"link":{"id":"80fd08177ebbe433cce28f72ece01093","originalFileName":"b965b1ca-dc78-4fdb-8ccc-9cb6a6b533e9-attachment.png","ext":".png","name":"newspec-c/evidence/dvc-tc25-s22-snf-02c-computer-after-phone-add.png","contentType":"image/png","used":true,"missed":false,"contentLength":87894},"type":"attachment"},{"link":{"id":"445dd9f9de10603ff60c670a6dce7f7d","originalFileName":"dee7fb19-36bf-4ef1-b400-9cc15e2b4480-attachment.png","ext":".png","name":"newspec-c/evidence/dvc-tc25-s22-snf-03a-phone-chart-before.device.png","contentType":"image/png","used":true,"missed":false,"contentLength":42981},"type":"attachment"},{"link":{"id":"1ea8dbf8e342ba8585d7647cdf68a93c","originalFileName":"e2283292-e769-4bda-8bcb-be741b57fa1d-attachment.png","ext":".png","name":"newspec-c/evidence/dvc-tc25-s22-snf-03b-phone-chart-after-computer-save.device.png","contentType":"image/png","used":true,"missed":false,"contentLength":215300},"type":"attachment"},{"link":{"id":"4482a10af5d243f39f1c656b66632d1f","originalFileName":"6c714078-73ed-4fe5-b728-945cc40bad86-attachment.png","ext":".png","name":"newspec-c/evidence/dvc-tc25-s22-snf-03c-computer-after-save.png","contentType":"image/png","used":true,"missed":false,"contentLength":121031},"type":"attachment"},{"link":{"used":true,"missed":false,"id":"2e0068804fa7f433a618b86cb973fd11","originalFileName":"1ac8080e-a10e-429c-bfb2-676f8ca128b8-attachment.png","ext":".png","contentType":"image/png","contentLength":181089,"name":"newspec-c/evidence/dvc-tc25-s22-snf-04a-phone-encounter.device.png"},"type":"attachment"},{"link":{"used":true,"missed":false,"id":"8d854a2db077e069ae7841b25a9d27bb","originalFileName":"0d87801e-6595-46c1-a268-dc2abf895b35-attachment.png","ext":".png","contentType":"image/png","contentLength":187346,"name":"newspec-c/evidence/dvc-tc25-s22-snf-04b-phone-after-generate.device.png"},"type":"attachment"},{"link":{"id":"818f8320a28e9c407b6e1b1f305518a1","originalFileName":"4493e063-34c0-45b5-a62f-6ac76226793d-attachment.png","ext":".png","name":"newspec-c/evidence/dvc-tc25-s22-snf-04c-computer-post-round.png","contentType":"image/png","used":true,"missed":false,"contentLength":73051},"type":"attachment"},{"link":{"id":"2bda9ba48148426ab6525ad891139b17","originalFileName":"9060dc3f-3bec-41f2-8a01-3b0bcf0a786f-attachment.png","ext":".png","name":"newspec-c/evidence/dvc-tc25-s22-snf-05a-phone-list-before-delete.device.png","contentType":"image/png","used":true,"missed":false,"contentLength":227455},"type":"attachment"},{"link":{"id":"bb06f4b08672a36dc354a8bcd8b60dc6","originalFileName":"c0846c17-d262-499a-9be8-33c999e6deb7-attachment.png","ext":".png","name":"newspec-c/evidence/dvc-tc25-s22-snf-05b-phone-list-after-delete.device.png","contentType":"image/png","used":true,"missed":false,"contentLength":226054},"type":"attachment"},{"link":{"id":"e32ae98a3b217e640ec9945fd45bdf65","originalFileName":"c1a95841-12ea-4b95-966b-83fe6127f6c1-attachment.json","ext":".json","name":"newspec-c/evidence/dvc-tc25-s22-snf.json","contentType":"application/json","used":true,"missed":false,"contentLength":4646},"type":"attachment"},{"link":{"id":"7ff20fc2110dbcc2f2db5a66af62cb8c","originalFileName":"ac0e9782-9f64-447e-b42e-83942d6b4179-attachment.json","ext":".json","name":"lane result (newspec-c/results.json)","contentType":"application/json","used":true,"missed":false,"contentLength":6103},"type":"attachment"}],"error":{"message":"newspec-c: passed → passed (passed)\nAndroid rig: debug build of main e02167f bundled for the LOCAL stack only (bundle names 127.0.0.1:4510/4511, reached through adb reverse), built outside the checkout, on the rc_api36 emulator (Pixel 7, Android 16); Playwright attached to the app's own WebView; every ai/* action the app sends is answered or failed at the WebView's socket (no model call; aiCallLog had no new row in any run). Phone = the app, signed in through its own email-code form (POST 200, its own session); computer = desktop Chromium with a separate session, Hospital (S01 loop) and Nursing Home (S02 loop). T3 (TFA-92570, judged): own-form sign-in, an add made in the app is stored and listed like a web add, the computer's pre-round save reaches the app's chart the same way it reaches a second web session, Generate in the app (scripted note) stores and shows the note, and a delete on the computer removes the patient for the app: Hospital 8/8, Nursing Home 6/6 judged checks (no resident delete control exists on web or app: known B24 / Q3). Recorded only (U1-U6, gated TFA-94513 in progress / TFA-94704 backlog): the computer stayed signed in after the phone's sign-in; the phone's add showed on the computer without a refresh (3 ms / 309 ms); the phone's note showed on the computer's Post-Round without a refresh; the delete reached the phone in 322 ms; Nursing Home pre-round text and BP showed live on the phone. Hospital: the computer's saved pre-round TEXT did not appear on the app's open chart (nor on a second…"},"testCase":{"id":"145f3434094513f2e0cd0948424c90e3","externalId":"34a8cb925152b3e652a2ad4d807bb1dd","name":"[local] S22 Android app (debug build on the local stack) and desktop Chrome: steps 2-5 in both modes","fullName":"TC-25 Web & Phone Sync › TC-25/S22"},"descriptionHtml":"<div class=\"rc-approach\"><p><b>Approach</b> · TC-25 Web &amp; Phone Sync · <b>S22</b> Android app (debug build on the local stack) and desktop Chrome: steps 2-5 in both modes</p><p><b>UAT steps / ticket ACs covered:</b></p><ul><li><b>U1</b> The same account is signed in on a phone (app) and a computer (web) at the same time. Signing in on one does not sign out the other, and both stay signed in. (UAT TC-25 step 1; UAT TC-25; TFA-94513 AC 9; TFA-94704 AC 5) — gate: blocked: TFA-94513 in progress; TFA-94704 development backlog</li><li><b>U2</b> A patient added on the phone appears on the computer in real time, with no refresh or re-entry. (UAT TC-25 step 2; UAT TC-25; TFA-94704 AC 5; TFA-94513 AC 11) — gate: blocked: TFA-94513 in progress; TFA-94704 development backlog</li><li><b>U3</b> A pre-round note dictated and saved on the computer appears on the phone in real time, with no refresh, and can be continued on the phone without re-entering anything. (UAT TC-25 step 3; UAT TC-25; TFA-94513 AC 11; TFA-94704 AC 5) — gate: blocked: TFA-94513 in progress; TFA-94704 development backlog</li><li><b>U4</b> A note generated on the phone appears on the computer in real time, with no refresh. (UAT TC-25 step 4; UAT TC-25; TFA-94704 AC 5; TFA-94513 AC 11) — gate: blocked: TFA-94513 in progress; TFA-94704 development backlog</li><li><b>U5</b> A patient deleted on the computer disappears from the phone in real time. (UAT TC-25 step 5; UAT TC-25; TFA-94513 AC 18; TFA-94704 AC 5) — gate: blocked: TFA-94513 in progress; TFA-94704 development backlog</li><li><b>U6</b> Steps 2-5 (add, pre-round save, generate, delete) work the same in Nursing Home as in Hospital. (UAT TC-25 step 6; UAT TC-25; UAT 3.3) — gate: blocked: TFA-94513 in progress; TFA-94704 development backlog</li><li><b>T3</b> On the phone app, TC-25's own steps behave as on the web: the same email-code login, and the same add, pre-round save, Generate and delete results. (TFA-94704 AC 5; TFA-92570 What) — gate: blocked: TFA-94704 development backlog</li></ul><p><b>Test design technique: </b>Device (device) — Look at the layout and gestures at phone size or on a real device (iPhone / Pixel).</p><p><b>Given </b>Android emulator with the main debug build pointed at the local stack, signed in with its own email code; desktop Chrome with its own session</p><p><b>When </b>Run S01's steps with the app as the phone, then S02's</p><p><b>Then </b>Same results as S01 and S02 on the real app's WebView</p><p><b>Pass rule (oracle, excerpt): </b>Same checkpoints as S01/S02, read from the WebView page (android-lane screenshots plus text). Until the lane signs in through the app's own form, its run is not evidence for T1 or TFA-94513 AC 10</p><p><b>Where it ran: </b>local newspec-c (new Playwright specs); test method DEVICE · Real device (iOS / Android); lane planned in the matrix: visual / mobile (blocked)</p><p><small>S22 is our own case number (its number in the coverage matrix cases/TC-25.matrix.json), not a step number of the UAT document.</small></p></div><p><b>Environment: local</b> — main e02167f → 25acd727 (10-15/16/17 re-tests), local stack (not a deployed build); run folder <code>runs/2026-10-14-local</code>, lane newspec-c.</p><p><b>Test method:</b> DEVICE · Real device (iOS / Android); secondary: MULTI · Multi-device / multi-account — as classified in cases/test-methods.json, which says it runs on local; Source: <code>newspec-c</code>.</p><p><b>UAT item:</b> TC-25 Web &amp; Phone Sync · <b>Section:</b> A5 · Cross-Cutting · <b>Scenario:</b> TC-25/S22</p><p><b>Android app (debug build on the local stack) and desktop Chrome: steps 2-5 in both modes</b></p><p><b>Tickets:</b> TFA-92570 Mobile: Capacitor wrap for App Store &amp; Google Play (ready for qa); TFA-94513 Signing In &amp; Session Security (in progress); TFA-94704 Production Web App Hosting + PWA (development backlog)</p><p><b>New local lane</b> <code>newspec-c</code>: status <b>passed</b> in <code>newspec-c/results.json</code> → <b>passed</b> (passed).</p><p><b>Detail:</b></p><pre style=\"white-space:pre-wrap\">Android rig: debug build of main e02167f bundled for the LOCAL stack only (bundle names 127.0.0.1:4510/4511, reached through adb reverse), built outside the checkout, on the rc_api36 emulator (Pixel 7, Android 16); Playwright attached to the app's own WebView; every ai/* action the app sends is answered or failed at the WebView's socket (no model call; aiCallLog had no new row in any run). Phone = the app, signed in through its own email-code form (POST 200, its own session); computer = desktop Chromium with a separate session, Hospital (S01 loop) and Nursing Home (S02 loop). T3 (TFA-92570, judged): own-form sign-in, an add made in the app is stored and listed like a web add, the computer's pre-round save reaches the app's chart the same way it reaches a second web session, Generate in the app (scripted note) stores and shows the note, and a delete on the computer removes the patient for the app: Hospital 8/8, Nursing Home 6/6 judged checks (no resident delete control exists on web or app: known B24 / Q3). Recorded only (U1-U6, gated TFA-94513 in progress / TFA-94704 backlog): the computer stayed signed in after the phone's sign-in; the phone's add showed on the computer without a refresh (3 ms / 309 ms); the phone's note showed on the computer's Post-Round without a refresh; the delete reached the phone in 322 ms; Nursing Home pre-round text and BP showed live on the phone. Hospital: the computer's saved pre-round TEXT did not appear on the app's open chart (nor on a second web session; the panel BP did, in ~0.3 s) until the chart was reopened, and a follow-up probe (dvc-tc25-s22-probe-stale-preround) showed that typing into that stale empty box on the phone replaced the computer's saved note on the server (see newFindings). Note: the 01:46 run's tripwire line 'FORBIDDEN notes.generateNote +16' came from the old count-based tripwire reading a partial table at mark time; aiCallLog had no row newer than 09:00:54Z at all (checked), and the tripwire is now time-based.</pre><p><b>Evidence:</b> 38 attached.</p><p><b>Dev run:</b> skipped: set-aside — set-aside: iOS/Android (Quinn 2026-10-14) — Needs the Android app (the debug build on the emulator, android-lane.ts) as the phone; iOS and Android are set aside for the dev run (Quinn 2026-10-14).. This local result replaces that dev entry (the scenario appears once).</p>","environment":"default","setup":[],"teardown":[],"history":[],"retries":[],"breadcrumbs":[["TC-25 Web & Phone Sync","S22 Android app (debug build on the local stack) and desktop Chrome: steps 2-5 in both modes"]],"retry":false,"titlePath":[],"retriesCount":0,"attachments":[{"
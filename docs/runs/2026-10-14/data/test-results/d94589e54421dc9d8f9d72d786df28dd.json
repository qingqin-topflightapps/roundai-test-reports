contentLength":54413,"name":"screenshot"},"type":"attachment"}],"parameters":[],"start":1791939349340,"stop":1791939349340,"duration":0,"type":"step","hasSimilarErrorInSubSteps":false},{"stepId":"eb67dbfa00d8e947295e911af1a2cd91","name":"s02-list-after.md (/snf): Pass","status":"passed","steps":[{"link":{"used":true,"missed":false,"id":"84082ff4988b232578abb7c958304a3b","originalFileName":"7f76868d-ba32-4d5f-b391-05852ec95465-attachment.txt","ext":".txt","contentType":"text/plain","contentLength":2136,"name":"page snapshot (accessibility tree)"},"type":"attachment"},{"link":{"used":true,"missed":false,"id":"d289e861d3a55f0f638d68bdcdff5ca6","originalFileName":"f76ae61e-7486-4ae6-a6f6-40fd8ccd6f1c-attachment.png","ext":".png","contentType":"image/png","contentLength":71082,"name":"screenshot"},"type":"attachment"}],"parameters":[],"start":1791939349340,"stop":1791939349340,"duration":0,"type":"step","hasSimilarErrorInSubSteps":false},{"link":{"used":true,"missed":false,"id":"eb8dd2d2837349978317d3ae83233b13","originalFileName":"064ea730-d4ec-4a4f-a180-9be35867d09c-attachment.txt","ext":".txt","contentType":"text/plain","contentLength":2315,"name":"agent's notes (facts it saw, not a verdict)"},"type":"attachment"},{"link":{"used":true,"missed":false,"id":"030c2e8bbdb7908dd3b6a8331e8b80ac","originalFileName":"04e7e0ca-2059-4ef8-91eb-05d72bb73b6d-attachment.json","ext":".json","contentType":"application/json","contentLength":4674,"name":"oracle verdict"},"type":"attachment"}],"error":{"message":"Checked by Quinn's runner (ledger.md #61): Pass — UAT TC-06 main flow both modes: add form toggle (default Follow-up), template preselected per badge, hand override, reload, list badge"},"testCase":{"id":"7e0fcf69219b7858a7fe527b19b40ea9","externalId":"419feda10d91cc861ed3633952b30709","name":"[dev] S02 Nursing Home walk (step 7): add-form default, list badge, all three states by hand incl. back to Follow-up, pre-selection, override, reload","fullName":"TC-06 Admission Status Toggle › TC-06/S02"},"descriptionHtml":"<div class=\"rc-approach\"><p><b>Approach</b> · TC-06 Admission Status Toggle · <b>S02</b> Nursing Home walk (step 7): add-form default, list badge, all three states by hand incl. back to Follow-up, pre-selection, override, reload</p><p><b>UAT steps / ticket ACs covered:</b></p><ul><li><b>U1</b> Nothing is ever New Admission (or Consult) unless the physician set it: the app never guesses the status, and a patient nobody has set reads Follow-up (UAT TC-06)</li><li><b>U3</b> The manual add form has the three-state toggle (New Admission / Follow-up / Consult) at creation, it defaults to Follow-up, and the state chosen there (or left untouched) is the one saved (UAT TC-06; TFA-92584 AC 2; TFA-92584 AC 3)</li><li><b>U4</b> The physician can change the badge by hand at any time (before or after Generate, and on a patient whose status already rolled) through all three states, and each change persists (list, chart, reload … (UAT TC-06; TFA-92584 AC 1)</li><li><b>U8</b> The badge pre-selects the template at Generate: Hospital New Admission -&gt; H&amp;P, Follow-up -&gt; SOAP progress, Consult -&gt; Consult note; … (UAT TC-06; TFA-92584 AC 6; TFA-92584 AC 7)</li><li><b>U9</b> The physician still sees the template picker at Generate and can change the pre-selected template by hand; changing the template does not change the badge, and Generate writes the note in the templat … (UAT TC-06; TFA-92584 AC 6)</li><li><b>U12</b> All of the above works in both Hospital and Nursing Home (step 7, ground rule 3.3) (UAT TC-06; UAT 3.3; TFA-92584 AC 7)</li><li><b>T2</b> Discharge templates (Discharge summary; SNF discharge once it exists) are never pre-selected by the badge in either context; they are only chosen by hand (UAT TC-06 step 6) (UAT TC-06; TFA-92584 AC 6; TFA-92599 AC 6)</li></ul><p><b>Test design technique: </b>Happy path (happy-path) — Walk the normal flow exactly as the UAT / ticket words it; everything it names has to show up.</p><p><b>Given </b>Same fixture; the Nursing Home resident nobody has set a status for</p><p><b>When </b>Repeat S01 in Nursing Home: untouched Add Resident form; resident chart Encounter tab with Follow-up, New Admission, Consult; with Consult set, override Note Format to SNF admission; reload; list; then change the status by hand back to Follow-up (step 5 in Nursing Home); list again</p><p><b>Then </b>Add form Follow-up by default; Follow-up -&gt; SNF follow-up; New Admission -&gt; SNF admission; Consult never pre-selects SNF admission or SNF discharge; the override does not change the badge; Consult survives the reload and shows on the list; the hand change to Follow-up is saved, pre-selects SNF follow-up and shows on the list</p><p><b>Pass rule (oracle, excerpt): </b>UAT TC-06 step 7 (steps 1-6 in Nursing Home, including step 3 'through all three states' and step 5's hand change to Follow-up) + TFA-92584 AC 6, 7. oracle.mjs on [selected] options. Nursing Home Consult must never pre-select SNF admission or SNF discharge (U8, not gated); …</p><p><b>Where it ran: </b>dev unit U61; test method AGENT · Browser agent; lane planned in the matrix: browser agent (automated)</p><p><small>S02 is our own case number (its number in the coverage matrix cases/TC-06.matrix.json), not a step number of the UAT document.</small></p></div><p><b>Environment: dev</b> — dev deployment, build <code>e02167f</code> (Deploy Convex, 2026-10-12T18:24:27Z); account and address are not written into the report; run folder <code>runs/2026-10-14-dev</code>.</p><p><b>Test method:</b> AGENT · Browser agent; secondary: PW · Playwright script — as classified in cases/test-methods.json, which says it runs on both; Source: <code>dev</code>.</p><p><b>UAT item:</b> TC-06 Admission Status Toggle · <b>Section:</b> A1 · Home Screen &amp; Dashboard · <b>Scenario:</b> TC-06/S02</p><p><b>Nursing Home walk (step 7): add-form default, list badge, all three states by hand incl. back to Follow-up, pre-selection, override, reload</b></p><p><b>Tickets:</b> TFA-92584 Admission Status Toggle (ready for qa); TFA-92599 Hospital vs. Nursing-Home Context Switch (in progress)</p><p><b>Result:</b> Pass from <code>scripts/oracle.mjs</code> on the saved evidence (<code>units/U61.verdict.json</code>), unit U61 split by its parts' checkpoints. Agent: 88 turns, 217 s, $0.66.</p><p><b>Plan:</b> unit U61 (#51, rest, ui-only) — Badge walk with template pre-selection. Same legacy seed, same controls; S01 works only the Hospital patient and S02 only the resident, so neither touches the other's chart. Runs together with TC-06/S01.</p><p><b>Checked by Quinn's runner</b> (<code>ledger.md</code> #61, U61; checked: yes): <b>Pass</b> — UAT TC-06 main flow both modes: add form toggle (default Follow-up), template preselected per badge, hand override, reload, list badge</p>","environment":"default","setup":[],"teardown":[],"history":[],"retries":[],"breadcrumbs":[["TC-06 Admission Status Toggle","S02 Nursing Home walk (step 7): add-form default, list badge, all three states by hand incl. back to Fo…"]],"retry":false,"titlePath":[],"retriesCount":0,"attachments":[{"link":{"used":true,"missed":false,"id":"1fcb1fc81886e9eff7b5f59b3ad9cac5","originalFileName":"e2f21cc7-ebaf-4c43-b420-36696288e5c9-attachment.txt","ext":".txt","contentType":"text/plain","contentLength":1547,"name":"page snapshot (accessibility tree)"},"type":"attachment"},{"link":{"used":true,"missed":false,"id":"3c9b8abf1a0cb62248b39fac5ee95061","originalFileName":"bf5d22ed-5128-417d-8afb-d887c8abcfa8-attachment.png","ext":".png","contentType":"image/png","contentLength":51124,"name":"screenshot"},"type":"attachment"},{"link":{"used":true,"missed":false,"id":"a51fdfd64fc8a4098ad1849f2996bf23","originalFileName":"25cab628-6383-4570-b611-783d738a5338-attachment.txt","ext":".txt","contentType":"text/plain","contentLength":2136,"name":"page snapshot (accessibility tree)"},"type":"attachment"},{"link":{"used":true,"missed":false,"id":"cac32f31515fa40689c3